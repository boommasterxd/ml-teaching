{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "scripts/*.{ts,mjs}",
    ".github/scripts/*.{ts,mjs}",
    ".github/scripts/cache-lifecycle/types.d.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "test/**/*.{ts,tsx,mjs}",
    "scripts/**/*.{ts,mjs}",
    ".github/scripts/**/*.{ts,mjs,cjs}",
    "csp/**/*.mjs"
  ],
  "ignoreIssues": {
    "csp/runtime/policy.mjs": ["exports"]
  }
}
