{
  "name": "ml-teaching",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node csp/check-build.mjs prepare",
    "build": "next build",
    "postbuild": "node csp/check-build.mjs verify",
    "prestart": "node csp/check-build.mjs verify",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "node scripts/check-source-boundaries.ts",
    "check:quality": "node scripts/check-quality-limits.ts",
    "check:dead-code": "knip",
    "check:duplication": "jscpd --config .jscpd.json",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit": "npm audit --include=dev --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run check:boundaries && npm run check:quality && npm run check:dead-code && npm run check:duplication && npm run audit:production && npm run test:coverage",
    "ui:audit": "animate-ui audit src --json",
    "ui:info": "shadcn info --json",
    "skills:list": "skills list --agent codex",
    "test:lighthouse": "node scripts/check-lighthouse.ts"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.6",
    "@base-ui/react": "1.9.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@tensorflow-models/knn-classifier": "^1.2.6",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "image-dimensions": "^2.6.0",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-remove-scroll": "^2.7.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@animate-ui/cli": "^2.4.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "lighthouse": "^13.6.0",
    "parse5": "8.1.1",
    "prettier": "^3.10.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "skills": "^1.9.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
