{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-server",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": [
    "server.ts"
  ],
  "exclude": [
    "node_modules",
    "src"
  ]
}
